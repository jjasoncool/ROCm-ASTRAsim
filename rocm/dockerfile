ARG VERSION=latest
FROM rocm/pytorch:${VERSION}

# 更新包列表並安裝 OpenMPI
RUN apt-get update && apt-get install -y \
    build-essential \
    cmake \
    # openmpi
    openmpi-bin openmpi-common libopenmpi-dev \
    # ASTRA-sim 需要的依賴
    libprotobuf-dev protobuf-compiler \
    libboost-dev libboost-program-options-dev \
    graphviz \
    # rocm 頻寬測試工具
    rocm-bandwidth-test

WORKDIR /workspace
RUN git clone https://github.com/ROCm/rccl-tests.git && \
    cd rccl-tests && \
    # 使用 MPI=1 編譯以支援多卡通訊測試
    make MPI=1 MPI_HOME=/usr/lib/x86_64-linux-gnu/openmpi

# 設置 Horovod 環境變數
ENV HOROVOD_GPU=ROCM \
    HOROVOD_ROCM_HOME=/opt/rocm \
    HOROVOD_GPU_OPERATIONS=NCCL \
    HOROVOD_WITHOUT_TENSORFLOW=1 \
    HOROVOD_WITH_PYTORCH=1 \
    HOROVOD_WITH_MPI=1 \
    HOROVOD_WITHOUT_MXNET=1

# 安裝 Horovod 和其他依賴
RUN git clone --recursive https://github.com/horovod/horovod.git /workspace/horovod
RUN ln -s $ROCM_PATH/lib/cmake/hip/FindHIP* /workspace/horovod/cmake/Modules/
RUN sed -i 's/rccl\.h/rccl\/rccl\.h/' /workspace/horovod/horovod/common/ops/nccl_operations.h
RUN pip install --no-cache-dir /workspace/horovod/.

# 安裝 ASTRA-sim
ENV ASTRA_SIM="/workspace/astra-sim"
RUN git clone --recursive https://github.com/astra-sim/astra-sim.git ${ASTRA_SIM} && \
    cd ${ASTRA_SIM} && git checkout 28f18ea && \
    git submodule update --init --recursive
WORKDIR ${ASTRA_SIM}
RUN ./build/astra_analytical/build.sh
ENV ASTRA_SIM_BIN=${ASTRA_SIM}/build/astra_analytical/build/bin/AstraSim_Analytical_Congestion_Aware

# 編譯 astra-sim 的 ns3 模組
WORKDIR /workspace/astra-sim/extern/network_backend/ns-3
RUN git checkout astra-sim
WORKDIR ${ASTRA_SIM}

# astra-sim patch，see patches/ files。
ARG ASTRA_PATCHES=all
COPY patches/ /tmp/patches/
# 必要：spdlog_setup 缺 fmt include，沒有這個編不過
RUN python3 /tmp/patches/spdlog_fmt_compat.py ${ASTRA_SIM}
# 選用：除錯用的 instrumentation。
RUN case "$ASTRA_PATCHES" in \
      all) python3 /tmp/patches/statistics_comm_intervals.py ${ASTRA_SIM} && \
           python3 /tmp/patches/entry_flow_diagnostics.py ${ASTRA_SIM} ;; \
      none) echo "[patches] instrumentation skipped (ASTRA_PATCHES=none)" ;; \
      *) echo "[patches] ERROR: ASTRA_PATCHES must be 'all' or 'none', got '$ASTRA_PATCHES'" >&2; exit 1 ;; \
    esac
RUN ./build/astra_ns3/build.sh -c 2>&1 | tee /workspace/ns3_build_log.txt

# 安裝 Chakra (用 mlcommons/chakra ec41090)
# fix protobuf 版本造成的 gencode/runtime 衝突
RUN git clone https://github.com/mlcommons/chakra.git /workspace/chakra && \
    cd /workspace/chakra && \
    git checkout ec410904d5e8b88c231df64ad0ec3aa313393484 && \
    pip install --no-cache-dir .

RUN pip install -U protobuf

# grpcio-tools 沒有鎖定版本，gencode 有可能導致 build 出壞 image 故此處需先阻擋並失敗
RUN python3 -c "from chakra.schema.protobuf.et_def_pb2 import Node" \
    || (echo "[check] chakra protobuf gencode/runtime 不相容" >&2; exit 1)

# 安裝其他 Chakra 依賴 Param
# REF https://github.com/mlcommons/chakra/blob/main/USER_GUIDE.md
# 安裝 PARAM (Chakra 依賴)
WORKDIR /workspace
RUN git clone https://github.com/facebookresearch/param.git && \
    cd param/et_replay && \
    git checkout 7b19f586dd8b267333114992833a0d7e0d601630 && \
    pip install .

# 安裝 Holistic Trace Analysis (用於追蹤分析)
WORKDIR /workspace
RUN git clone https://github.com/facebookresearch/HolisticTraceAnalysis.git && \
    cd HolisticTraceAnalysis && \
    git checkout v0.5.0 && \
    git submodule update --init && \
    pip install -r requirements.txt && \
    pip install -e .

RUN pip install --no-cache-dir hiredis

# LLM trace collection 支援 (Qwen2.5-0.5B, Llama-3.2-1B)
RUN pip install --no-cache-dir transformers accelerate sentencepiece

# 設置工作目錄
WORKDIR /workspace
